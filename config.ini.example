# 深知可信搜索 API 配置文件
#
# 推荐由 Agent 运行 scripts/register.mjs，通过手机号和短信验证码
# 自动注册并把 API Key 写入本地 config.ini。注册请求不传 channel
# 字段，由 MaaS 使用默认渠道。
#
# 如自动注册不可用，可访问：
# https://platform.dknowc.cn/auth/#/register?type=6
# 手动注册后，将本文件复制为 config.ini，并用实际 API Key
# 替换 your_api_key_here。
#
# 搜索接口固定使用：https://open.dknowc.cn/dependable/search/

[dkag]
api_key=your_api_key_here
