# 深知可信搜索 API 配置文件
#
# 获取 API Key：
# 1. 访问 MaaS 管理平台：
#    https://platform.dknowc.cn/
# 2. 注册并登录深知 MaaS 平台
# 3. 获取深知可信搜索 API Key
# 4. 将本文件复制为 config.ini
# 5. 把 your_api_key_here 替换为实际 API Key
#
# 新用户注册后会有 300 次体验额度；体验额度用完后，可到 MaaS 管理平台充值。
# 完成实名认证后，平台也可能提供 100 元赠金，具体以 MaaS 平台页面展示为准。
#
# 搜索接口固定使用：https://open.dknowc.cn/dependable/search/

[dkag]
api_key=your_api_key_here
